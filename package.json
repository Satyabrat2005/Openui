{
    "name": "openui",
    "version": "7.1.4",
    "description": "OpenUI — a cross-platform (Windows + macOS) menu-bar / system-tray AI assistant (Electron + Vite + React + TypeScript)",
    "main": "./out/main/index.js",
    "author": "OpenUI",
    "license": "MIT",
    "scripts": {
        "postinstall": "electron-builder install-app-deps && node scripts/generate-tray-icon.cjs && node scripts/convert-icon.js",
        "icons": "node scripts/generate-tray-icon.cjs && node scripts/convert-icon.js",
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "fetch:ocr-langs": "node scripts/fetch-traineddata.cjs",
        "build:mac": "node scripts/fetch-traineddata.cjs && electron-vite build && electron-builder --mac --publish never",
        "build:win": "node scripts/fetch-traineddata.cjs && electron-vite build && electron-builder --win --publish never"
    },
    "build": {
        "appId": "com.openui.app",
        "productName": "OpenUI",
        "publish": {
            "provider": "github",
            "owner": "Satyabrat2005",
            "repo": "Openui"
        },
        "directories": {
            "output": "dist"
        },
        "files": [
            "out/**/*",
            "resources/**/*",
            "package.json"
        ],
        "protocols": [
            {
                "name": "OpenUI Auth",
                "schemes": [
                    "openui"
                ]
            }
        ],
        "asarUnpack": [
            "**/*.node",
            "**/node_modules/ffmpeg-static/**"
        ],
        "extraResources": [
            {
                "from": "resources",
                "to": "resources"
            },
            {
                "from": "tessdata",
                "to": "tessdata"
            }
        ],
        "npmRebuild": true,
        "afterSign": "scripts/notarize.js",
        "mac": {
            "category": "public.app-category.productivity",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                }
            ],
            "icon": "resources/icon.icns",
            "protocols": [
                {
                    "name": "OpenUI Auth",
                    "schemes": [
                        "openui"
                    ]
                }
            ],
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "resources/entitlements.mac.plist",
            "entitlementsInherit": "resources/entitlements.mac.plist",
            "extendInfo": {
                "NSMicrophoneUsageDescription": "OpenUI uses the microphone for push-to-talk voice input, transcribed via Whisper.",
                "NSAppleEventsUsageDescription": "OpenUI can open and control other apps (e.g. Calendar) when you ask it to."
            }
        },
        "dmg": {
            "title": "${productName} ${version}",
            "artifactName": "${productName}-${arch}.${ext}",
            "background": "resources/dmg-background.png",
            "window": {
                "width": 540,
                "height": 380
            },
            "contents": [
                {
                    "x": 140,
                    "y": 190,
                    "type": "file"
                },
                {
                    "x": 400,
                    "y": 190,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "ia32"
                    ]
                }
            ],
            "icon": "resources/icon.ico",
            "artifactName": "OpenUI-Setup-${version}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "installerIcon": "resources/icon.ico",
            "uninstallerIcon": "resources/icon.ico",
            "uninstallDisplayName": "OpenUI",
            "installerHeader": "resources/installer-header.bmp",
            "installerSidebar": "resources/installer-sidebar.bmp",
            "uninstallerSidebar": "resources/installer-sidebar.bmp",
            "license": "LICENSE",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "OpenUI",
            "runAfterFinish": true,
            "menuCategory": "OpenUI",
            "deleteAppDataOnUninstall": false
        }
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.40.0",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@nut-tree-fork/nut-js": "^4.2.0",
        "@octokit/rest": "^20.0.0",
        "@sentry/electron": "^7.15.0",
        "@supabase/supabase-js": "^2.108.2",
        "@types/better-sqlite3": "^7.6.13",
        "adm-zip": "^0.5.18",
        "better-sqlite3": "^12.11.1",
        "docx": "^9.7.1",
        "dotenv": "^16.6.1",
        "electron-updater": "^6.8.9",
        "exceljs": "^4.4.0",
        "ffmpeg-static": "^5.3.0",
        "fluent-ffmpeg": "^2.1.3",
        "gsap": "^3.12.5",
        "jimp": "^0.22.10",
        "ollama": "^0.5.0",
        "openai": "^4.0.0",
        "pdf-lib": "^1.17.1",
        "pdf-parse": "^2.4.5",
        "pixelmatch": "^4.0.2",
        "playwright": "^1.44.0",
        "posthog-node": "^4.18.0",
        "pptxgenjs": "^4.0.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tesseract.js": "^5.1.0"
    },
    "optionalDependencies": {
        "hnswlib-node": "^3.0.0"
    },
    "devDependencies": {
        "@electron/notarize": "^2.5.0",
        "@eslint/js": "^9.39.5",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/adm-zip": "^0.5.8",
        "@types/better-sqlite3": "^7.6.13",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/node": "^22.10.1",
        "@types/pdf-parse": "^1.1.5",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "electron": "^42.4.1",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^15.15.0",
        "jsdom": "^25.0.1",
        "jszip": "^3.10.1",
        "png2icons": "^2.0.1",
        "postcss": "^8.4.49",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.64.0",
        "vite": "^7.3.5",
        "vitest": "^2.1.9"
    }
}
