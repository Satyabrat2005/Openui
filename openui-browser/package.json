{
  "name": "openui-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "OpenUI Web — the browser-first automation surface. The UI is a direct port of the desktop Run Console (RunConsole.tsx); only the data layer differs (REST/SSE instead of Electron IPC).",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts web",
    "build:web": "vite --config web/vite.config.ts build web",
    "start": "tsx src/server.ts",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "typecheck:api": "tsc -p tsconfig.server.json",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
